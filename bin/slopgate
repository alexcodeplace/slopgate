#!/usr/bin/env node
// Native-engine launcher. The selected binary owns checking and provenance;
// this shim only resolves the executable and provisioned package dependencies.
import { spawnSync } from 'node:child_process';
import { existsSync, realpathSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import os from 'node:os';

if (process.env.SLOPGATE_SHIM_ACTIVE === '1') {
  process.stderr.write('slopgate: recursive shim invocation detected; aborting.\n');
  process.exit(2);
}
process.env.SLOPGATE_SHIM_ACTIVE = '1';
try {
  if (os.getPriority() < 0) os.setPriority(0);
} catch { /* Priority controls are not available on every supported host. */ }

const selfPath = fileURLToPath(import.meta.url);
const pkgRoot = join(dirname(selfPath), '..');
const host = `${process.platform}-${process.arch}`;
const binName = process.platform === 'win32' ? 'slopgate-rs.exe' : 'slopgate-rs';
const nativePackage = {
  'linux-x64': 'cli-linux-x64-gnu', 'linux-arm64': 'cli-linux-arm64-gnu',
  'darwin-x64': 'cli-darwin-x64', 'darwin-arm64': 'cli-darwin-arm64',
  'win32-x64': 'cli-win32-x64-msvc', 'win32-arm64': 'cli-win32-arm64-msvc',
}[host];

// Preserve upstream support for a global installation whose consumer has no
// node_modules. Prefer the provisioned native AST binary over runtime/.cmd shims.
const depBin = join(pkgRoot, 'node_modules', '.bin');
let nativeDependencyDirectory;
try {
  const cliRoot = realpathSync(join(pkgRoot, 'node_modules', '@ast-grep', 'cli'));
  const candidate = join(dirname(cliRoot), nativePackage || 'unsupported-platform');
  const executable = process.platform === 'win32' ? 'ast-grep.exe' : 'ast-grep';
  if (existsSync(join(candidate, executable))) nativeDependencyDirectory = candidate;
} catch { /* A development checkout may provision tooling separately. */ }
const pathKey = Object.keys(process.env).find((key) => key.toLowerCase() === 'path') || 'PATH';
process.env[pathKey] = [nativeDependencyDirectory, depBin, process.env[pathKey]]
  .filter(Boolean).join(process.platform === 'win32' ? ';' : ':');

const isSelf = (path) => {
  try { return realpathSync(path) === realpathSync(selfPath); }
  catch { return false; }
};
const candidates = [
  process.env.SLOPGATE_BIN,
  join(pkgRoot, 'vendor', host, binName),
  join(pkgRoot, 'target', 'release', binName),
].filter(Boolean);
const explicit = process.env.SLOPGATE_BIN;
const bin = explicit
  ? (existsSync(explicit) && !isSelf(explicit) ? explicit : undefined)
  : candidates.find((path) => existsSync(path) && !isSelf(path));
if (!bin) {
  process.stderr.write(
    `slopgate: native engine binary not found for ${host}.\n` +
    '  An explicit SLOPGATE_BIN must identify a valid native engine, not this launcher.\n' +
    '  For a development checkout, build with cargo build --release.\n' +
    `  looked in: ${candidates.join(', ') || '(none)'}\n`,
  );
  process.exit(2);
}

// Resolve and validate the engine even for version queries. Report both public
// package and selected engine identities rather than disguising a stale override.
if (process.argv.length === 3 && ['--version', '-V'].includes(process.argv[2])) {
  const native = spawnSync(bin, ['--version'], { encoding: 'utf8', timeout: 5000 });
  if (native.error || native.status !== 0) {
    process.stderr.write(`slopgate: selected engine version probe failed: ${native.error?.message || native.stderr}\n`);
    process.exit(2);
  }
  try {
    const { version } = JSON.parse(readFileSync(join(pkgRoot, 'package.json'), 'utf8'));
    process.stdout.write(`slopgate ${version} (${native.stdout.trim()})\n`);
    process.exit(0);
  } catch (error) {
    process.stderr.write(`slopgate: cannot read package identity: ${error.message}\n`);
    process.exit(2);
  }
}
const result = spawnSync(bin, process.argv.slice(2), { stdio: 'inherit' });
if (result.error) {
  process.stderr.write(`slopgate: failed to execute engine (${bin}): ${result.error.message}\n`);
  process.exit(2);
}
process.exit(result.status ?? 2);
